@article{liuprocreation,
  title = {Procreation and Moral Reasons: Balancing Prerogatives and Harm},
  author = {Yumin Liu},
  year = {work in progress},
  % month = sep,
  % journal = {},
  % issn = {},
  % publisher = {},
  abstract = {Is it permissible to bring a person who is expected to lead a life not worth living into existence? Many philosophers say "no", arguing that creating a person with a life not worth living is impermissible because it causes severe harm to the person and/or to social welfare. In this paper, I will challenge this orthodox view. I will argue that in many cases not bringing the person into existence is not a moral obligation but rather a supererogation, for two reasons: first, parents always have prerogatives to have and raise children; second, the moral reasons against bringing the person into existence cannot always outweigh the overall reasons for bringing her into existence. Thus, there can be cases in which parents are permitted to create a child whose life is expected to be not worth living.},
  description={A philosophical analysis of procreation and harm that argues, through a framework of overall reasons and supererogation, that not creating a person with a not-worth-living life may be a moral ideal rather than an obligation.},
  keywords={Procreation; moral reason; the overall reasons; supererogation; prerogative; harm},
  % doi = {},
  % pdf = {papers/liuinquiry.pdf},
  % selected = {true},
}


