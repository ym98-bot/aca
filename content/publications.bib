@article{liuinquiry,
  title = {Inquiry, Supererogation, and Zetetic Norms},
  author = {Yumin Liu},
  year = {under review},
  % month = sep,
  % journal = {},
  % issn = {},
  % publisher = {},
  abstract = {Zetetic norms have received increasing attention in recent epistemology, yet existing accounts remain incomplete and struggle to explain permissible, prohibited, required, and supererogatory inquiry within a unified framework. This paper develops a decision-theoretic account that evaluates inquiry in terms of expected epistemic utility, understood broadly to include epistemic benefits and costs beyond accuracy. By introducing two context-sensitive utility thresholds, the framework provides a unified account of all four normative statuses of inquiry.},
  description={A two-threshold decision-theoretic framework explaining inquiry norms through expected epistemic utility.},
  keywords={Zetetic norms; inquiry; decision theory; expected epistemic utility; epistemic supererogation},
